# What does not go into the VSIX. `dist/extension.js` is the whole extension —
# esbuild bundles it with no runtime dependencies at all, which is why
# `vsce package --no-dependencies` is honest here rather than a shortcut.
src/**
test/**
tsconfig.json
vitest.config.ts
vitest.config.mts
.vscodeignore
.githooks/**
.github/**
.gitleaks.toml
.gitignore
CODEOWNERS
CONTRIBUTING.md
SECURITY.md
node_modules/**
**/*.map
**/*.vsix

# vsce reads this file, not .gitignore — a local .env would otherwise ship in
# the VSIX to every install. Mirror .gitignore's secret patterns here.
.env
.env.*
**/*.pem
**/*.key
**/credentials.json
