#!/bin/sh
# Full-history scan on push. Pre-commit only sees the staged diff.
#
# A credential removed in a later commit is still in history and still valid
# until rotated — so push is where we scan everything, with `.gitleaks.toml`.
set -e

ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$ROOT/.gitleaks.toml"

if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
  echo "pre-push: this is a shallow clone, so a full-history scan is not possible."
  echo ""
  echo "  git fetch --unshallow"
  echo ""
  echo "  A partial scan reporting 'no leaks' is worse than no scan."
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed, so history was NOT scanned."
  echo ""
  echo "  brew install gitleaks"
  echo ""
  echo "  To push anyway, deliberately: git push --no-verify"
  exit 1
fi

if [ ! -f "$CONFIG" ]; then
  echo "pre-push: missing $CONFIG — refusing to push without a scan config."
  exit 1
fi

gitleaks detect --source "$ROOT" --redact --no-banner --config "$CONFIG"
